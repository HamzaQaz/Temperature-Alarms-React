# Backend environment variables. Copy to .env and fill in the blanks.
# Startup fails with a message naming any required value that is missing.

# --- Server (optional) ---
PORT=3001
# A browser origin allowed to call the API besides the API's own (the Vite dev server, say).
# The origin the API is served on always passes, so the Compose stack leaves this unset.
CORS_ORIGIN=https://your-frontend-domain.example

# --- Database (DB_USER, DB_PASSWORD, DB_NAME required) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=tempuser
DB_PASSWORD=your_secure_password_here
DB_NAME=temperature_alarms

# --- Shared secrets (both required; see docs/adr/0003) ---
# Admin token: sent by the Settings page on every change to Campuses, Devices, and history.
ADMIN_TOKEN=change-me-admin
# Device token: sent by every Device with each Reading. Rotating it means reflashing every Device.
DEVICE_TOKEN=change-me-device
# Only during a rotation: the old Device token, still accepted until every board is reflashed
# with the new DEVICE_TOKEN; clear it then. Must differ from both tokens above.
# DEVICE_TOKEN_PREVIOUS=

# --- Behaviour (optional, defaults shown) ---
# How often a healthy Device reports. Offline is declared after three missed intervals.
REPORT_INTERVAL_SECONDS=30
# How many days of raw Readings to keep (docs/adr/0004).
RETENTION_DAYS=90
# Where Conditions begin (whole numbers). Mold risk is a fixed rule and has no knob.
HOT_WARNING_F=82
HOT_CRITICAL_F=90
COLD_WARNING_F=50
DRY_WARNING_PERCENT=20
MISSED_REPORTS_BEFORE_OFFLINE=3
# Zone the old per-Device tables' string dates were written in, used once when migrating them
# into `readings` (DEPLOYMENT.md). Defaults to the server's own zone; the PHP writer used America/Chicago.
# LEGACY_TIME_ZONE=America/Chicago

# --- Tests only ---
# Where `npm test` finds MySQL. Defaults to the Docker Compose database (`npm run test:db`).
# TEST_DATABASE_URL=mysql://temp:temp@127.0.0.1:3307/temperature_alarms_test
