# Dependencies
node_modules/

# Build outputs
frontend/dist/
backend/dist/
backend/logs/
*.log
arduino/**/build/
__pycache__/

# Environment files
.env
.env.*
!.env.example
# deploy.sh demo's throwaway secrets (covered by .env.* too; named so nobody narrows it away)
.env.demo

# Deploy script: database dumps, and the list of servers (copy deploy/servers.example.txt)
backups/
deploy/servers.txt

# The bench watcher's inventory sheet (every board's MAC), its log, and its save-in-progress
# file, should one be run from inside the repo; the README says to keep the sheet outside
/*.csv
/arduino/*.csv
*.bench.csv
*.csv.tmp

# Firmware secrets (copy config.example.h to config.h), and any exported firmware binary, which
# holds the WiFi password and the Device token in plain text, wherever it is copied
arduino/**/config.h
*.bin
*.bin.signed
*.legacy_sig
# The over-the-air signing keys (README, "Updating boards over the air"). private.key signs every
# build the boards will install, so it never leaves the build laptop and its offline backup.
arduino/**/private.key
arduino/**/public.key

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Review screenshots stay local
.scratch/rebuild/reviews/ui/
.scratch/design/motion/
.scratch/design/comps/bundle/
.scratch/design/incidents/
.scratch/design/campuses/
.scratch/design/round3/
.scratch/prodtest/runs/
.scratch/ct/shots/
