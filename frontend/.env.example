# Frontend environment variables. Copy to .env for local development.
# The only setting the frontend reads.

# Where the backend is, for `npm run dev`. Leave it UNSET to build for the Compose stack:
# nginx then serves the frontend and proxies /api/ from the same origin, so one build works
# on any hostname (docs/adr/0005). frontend/Dockerfile builds with nothing set.
VITE_API_URL=http://localhost:3001
