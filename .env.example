# Settings for the Docker Compose stack (compose.yaml). Copy to .env and fill in the four
# secrets; `docker compose up` refuses to start naming any that is unset. Generate each with:
#   openssl rand -hex 32
# deploy/deploy.sh install (or deploy.ps1 install) does all of this for you.

# --- Required ---
# Sent by the Settings page on every change to Campuses, Devices, and history (docs/adr/0003).
ADMIN_TOKEN=
# Sent by every Device with each Reading; goes into each board's config.h, so rotating it
# means reflashing every Device (deploy.sh rotate-device-token keeps the old one working meanwhile).
DEVICE_TOKEN=
# Password of the database user api connects as. The database is never published outside the stack.
DB_PASSWORD=
# Password of MySQL root, for backups and restores through `docker compose exec db`. Only the
# db container has it; api never does. MySQL takes it when the database volume is first created.
DB_ROOT_PASSWORD=

# --- Set only during a Device token rotation ---
# The Device token being retired, still accepted until every board is reflashed with the new
# DEVICE_TOKEN. deploy.sh rotate-device-token sets it, and --finish clears it (docs/adr/0003).
DEVICE_TOKEN_PREVIOUS=

# --- Optional, defaults shown ---
# The one published port: the dashboard and /api/ on http://<host>:WEB_PORT. With a TLS
# proxy on the host in front (DEPLOYMENT.md), prefix an address to keep the port off the
# network: WEB_PORT=127.0.0.1:8080
WEB_PORT=80
# Behind a TLS proxy (DEPLOYMENT.md, TLS in front of the stack): the proxy's address(es),
# comma-separated, or `gateway` for a proxy on this host. Empty: no proxy in front.
TRUST_PROXY=
# How often a healthy Device reports. Offline is declared after three missed intervals.
REPORT_INTERVAL_SECONDS=30
# How many days of raw Readings to keep (docs/adr/0004).
RETENTION_DAYS=90
# Where Conditions begin (whole numbers). Mold risk is a fixed rule and has no knob.
HOT_WARNING_F=82
HOT_CRITICAL_F=90
COLD_WARNING_F=50
DRY_WARNING_PERCENT=20
MISSED_REPORTS_BEFORE_OFFLINE=3
# Zone the old per-Device tables' string dates were written in, used once when migrating an
# old database in (DEPLOYMENT.md). Defaults to UTC, the container's zone; the PHP writer used
# America/Chicago, so set this before the first start against a restored dump.
# LEGACY_TIME_ZONE=America/Chicago
# MySQL's InnoDB buffer pool (MySQL size syntax: 512M, 1G). 512M keeps a week of 100 Devices'
# Readings in memory for the Campuses overview; use 1G from 300 Devices, on a CT with 4 GiB
# (DEPLOYMENT.md, Database settings and sizing). MySQL uses about this plus 400 MiB.
DB_BUFFER_POOL_SIZE=512M
